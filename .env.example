# Copy this file to .env.local (development) or set these in your host's
# environment settings (production). .env* files are gitignored — never
# commit real values.

# --- Admin sign-in (/admin) — REQUIRED in production -----------------------
# Your own email, and a strong password of at least 10 characters. With
# NODE_ENV=production the admin refuses every login until both are set.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional: a long random string used to sign admin session cookies
# (e.g. `openssl rand -hex 32`). Falls back to ADMIN_PASSWORD when empty.
# ADMIN_SESSION_SECRET=

# --- Customer accounts (sign up / sign in / wishlist) -----------------------
# A long random string that signs customer session cookies (e.g. `openssl rand -hex 32`).
# REQUIRED in production for customers to be able to sign in. If empty it falls back to
# ADMIN_SESSION_SECRET, then to a key derived from ADMIN_PASSWORD — set your own so changing
# the admin password never logs every customer out.
CUSTOMER_SESSION_SECRET=

# --- Database (MongoDB) — OFF until MONGODB_URI is set ---------------------------
# Where EVERYTHING is stored when set: customer accounts + wishlists, orders, service bookings, the product
# catalogue (and your admin edits) and photos uploaded in the admin. Works on Vercel, Hostinger or your own
# machine. Get a free cluster at https://www.mongodb.com/atlas: Database Access -> add a user, Network Access
# -> allow 0.0.0.0/0 (needed on Vercel), Connect -> Drivers -> copy the string and put the password in it.
# Without MONGODB_URI the shop stores everything as before (Vercel Blob / Netlify Blobs / files).
MONGODB_URI=
# MONGODB_DB=cyclewala     # database name inside the cluster (default cyclewala)
# USE_DATABASE=false       # switches MongoDB off while MONGODB_URI stays filled in

# --- Email alerts to the shop owner ---------------------------------------------------
# An email goes to cyclewalastore@gmail.com for every new customer account, every order and every service
# booking. It is sent through Gmail: turn on 2-step verification for that Google account, then create an
# "App password" (Google Account -> Security -> App passwords) and put it here. Never use the normal password.
# Without these two the site works exactly as before, it just does not send the emails.
SMTP_USER=cyclewalastore@gmail.com
SMTP_PASS=
# NOTIFY_EMAIL=cyclewalastore@gmail.com   # where the alerts go (default: cyclewalastore@gmail.com)
# SMTP_HOST=smtp.gmail.com                # only for a provider other than Gmail
# SMTP_PORT=465
# MAIL_DRY_RUN=true                       # print the emails in the server log instead of sending (testing)

# --- Site --------------------------------------------------------------------
# The public address of the site, no trailing slash. Used for the sitemap,
# link previews and search-engine data.
NEXT_PUBLIC_SITE_URL=https://cyclewala.vercel.app

# --- Data ---------------------------------------------------------------------
# Where orders, bookings, catalogue edits and uploaded photos are stored.
# Point this at a folder on a persistent disk OUTSIDE the deployed code, so a
# redeploy never wipes them. Defaults to ./data inside the project.
DATA_DIR=

# Vercel Blob: create a Blob store and connect it to the Vercel project.
# Vercel supplies this token automatically for the connected environments.
# BLOB_READ_WRITE_TOKEN=
