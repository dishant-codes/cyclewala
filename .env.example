# Copy this file to .env.local (development) or set these in your host's
# environment settings (production). .env* files are gitignored — never
# commit real values.

# --- Admin sign-in (/admin) — REQUIRED in production -----------------------
# Your own email, and a strong password of at least 10 characters. With
# NODE_ENV=production the admin refuses every login until both are set.
ADMIN_EMAIL= "gauravtote@cyclewala.com"
ADMIN_PASSWORD= "12345" 

# Optional: a long random string used to sign admin session cookies
# (e.g. `openssl rand -hex 32`). Falls back to ADMIN_PASSWORD when empty.
ADMIN_SESSION_SECRET=

# --- Site --------------------------------------------------------------------
# The public address of the site, no trailing slash. Used for the sitemap,
# link previews and search-engine data.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# --- Data ---------------------------------------------------------------------
# Where orders, bookings, catalogue edits and uploaded photos are stored.
# Point this at a folder on a persistent disk OUTSIDE the deployed code, so a
# redeploy never wipes them. Defaults to ./data inside the project.
DATA_DIR=
